	"Elementor Widget Class": {
		"prefix": "wpelwidget",
		"scope": "php",
		"body": [
			"/**",
			" * ${TM_FILENAME_BASE/_/ /g} Elementor Widget.",
			" *",
			" * @package {{NS}}\\Widgets",
			" */",
			"",
			"namespace {{NS}}\\Widgets;",
			"",
			"use Elementor\\Widget_Base;",
			"use Elementor\\Controls_Manager;",
			"use Elementor\\Repeater;",
			"",
			"if ( ! defined( 'ABSPATH' ) ) {",
			"\texit;",
			"}",
			"",
			"/**",
			" * Class ${1:${TM_FILENAME_BASE}}.",
			" */",
			"class ${1:${TM_FILENAME_BASE}} extends Widget_Base {",
			"",
			"\t/**",
			"\t * Get widget name.",
			"\t *",
			"\t * @return string",
			"\t */",
			"\tpublic function get_name() {",
			"\t\treturn '{{PREFIX}}_${TM_FILENAME_BASE/([^_]+)(_?)/${1:/downcase}${2:+-}/g}';",
			"\t}",
			"",
			"\t/**",
			"\t * Get widget title.",
			"\t *",
			"\t * @return string",
			"\t */",
			"\tpublic function get_title() {",
			"\t\treturn __( '${TM_FILENAME_BASE/_/ /g}', '{{SLUG}}' );",
			"\t}",
			"",
			"\t/**",
			"\t * Get widget icon.",
			"\t *",
			"\t * @return string",
			"\t */",
			"\tpublic function get_icon() {",
			"\t\treturn 'eicon-${2:code}';",
			"\t}",
			"",
			"\t/**",
			"\t * Get widget style dependencies.",
			"\t *",
			"\t * @return array",
			"\t */",
			"\tpublic function get_style_depends() {",
			"\t\treturn array( '{{PREFIX}}-${TM_FILENAME_BASE/([^_]+)(_?)/${1:/downcase}${2:+-}/g}' );",
			"\t}",
			"",
			"\t/**",
			"\t * Get widget script dependencies.",
			"\t *",
			"\t * @return array",
			"\t */",
			"\tpublic function get_script_depends() {",
			"\t\treturn array( '{{PREFIX}}-${TM_FILENAME_BASE/([^_]+)(_?)/${1:/downcase}${2:+-}/g}' );",
			"\t}",
			"",
			"\t/**",
			"\t * Get widget categories.",
			"\t *",
			"\t * @return array",
			"\t */",
			"\tpublic function get_categories() {",
			"\t\treturn array( '${3:general}' );",
			"\t}",
			"",
			"\t/**",
			"\t * Register controls for the widget.",
			"\t *",
			"\t * @return void",
			"\t */",
			"\tprotected function register_controls() {",
			"\t\t\\$this->start_controls_section(",
			"\t\t\t'content_section',",
			"\t\t\tarray(",
			"\t\t\t\t'label' => __( 'Content', '{{SLUG}}' ),",
			"\t\t\t\t'tab'   => Controls_Manager::TAB_CONTENT,",
			"\t\t\t),",
			"\t\t);",
			"",
			"\t\t\\$this->add_control(",
			"\t\t\t'title',",
			"\t\t\tarray(",
			"\t\t\t\t'label'       => __( 'Title', '{{SLUG}}' ),",
			"\t\t\t\t'type'        => Controls_Manager::TEXT,",
			"\t\t\t\t'default'     => __( 'Default Title', '{{SLUG}}' ),",
			"\t\t\t),",
			"\t\t);",
			"\t\t$0",
			"",
			"\t\t\\$this->end_controls_section();",
			"",
			"\t\t\\$this->start_controls_section(",
			"\t\t\t'style_section',",
			"\t\t\tarray(",
			"\t\t\t\t'label' => __( 'Style', '{{SLUG}}' ),",
			"\t\t\t\t'tab'   => Controls_Manager::TAB_STYLE,",
			"\t\t\t),",
			"\t\t);",
			"",
			"\t\t\\$this->add_control(",
			"\t\t\t'title_color',",
			"\t\t\tarray(",
			"\t\t\t\t'label'     => __( 'Title Color', '{{SLUG}}' ),",
			"\t\t\t\t'type'      => Controls_Manager::COLOR,",
			"\t\t\t\t'selectors' => array(",
			"\t\t\t\t\t'{{WRAPPER}} .title' => 'color: {{VALUE}};',",
			"\t\t\t\t),",
			"\t\t\t),",
			"\t\t);",
			"",
			"\t\t\\$this->end_controls_section();",
			"\t}",
			"",
			"\t/**",
			"\t * Render widget output on frontend.",
			"\t *",
			"\t * @return void",
			"\t */",
			"\tprotected function render() {",
			"\t\t\\$settings = \\$this->get_settings_for_display();",
			"",
			"\t\t\\$this->add_inline_editing_attributes( 'title', 'none' );",
			"\t\t?>",
			"\t\t<div class=\"${TM_FILENAME_BASE/([^_]+)(_?)/${1:/downcase}${2:+-}/g}-wrapper\">",
			"\t\t\t<?php if ( ! empty( \\$settings['title'] ) ) : ?>",
			"\t\t\t\t<h3 class=\"title\" <?php echo \\$this->get_render_attribute_string( 'title' ); // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped ?>><?php echo esc_html( \\$settings['title'] ); ?></h3>",
			"\t\t\t<?php endif; ?>",
			"\t\t</div>",
			"\t\t<?php",
			"\t}",
			"}"
	}
