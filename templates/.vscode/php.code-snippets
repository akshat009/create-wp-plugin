	"Elementor Widget Class": {
		"prefix": "wpelwidget",
		"body": [
			"<?php",
			"/**",
			" * ${1:Widget Title} Elementor Widget.",
			" *",
			" * @package {{NS}}\\Widgets",
			" */",
			"",
			"namespace {{NS}}\\Widgets;",
			"",
			"use Elementor\\Controls_Manager;",
			"",
			"if ( ! defined( 'ABSPATH' ) ) {",
			"\texit;",
			"}",
			"",
			"if ( ! class_exists( '\\\\Elementor\\\\Widget_Base' ) ) {",
			"\treturn;",
			"}",
			"",
			"/**",
			" * Class ${2:Widget_Name}.",
			" */",
			"class ${2:Widget_Name} extends Abstract_Widget {",
			"",
			"\t/**",
			"\t * Get widget name.",
			"\t *",
			"\t * @return string",
			"\t */",
			"\tpublic function get_name() {",
			"\t\treturn '{{PREFIX}}_${3:widget_slug}';",
			"\t}",
			"",
			"\t/**",
			"\t * Get widget title.",
			"\t *",
			"\t * @return string",
			"\t */",
			"\tpublic function get_title() {",
			"\t\treturn __( '${1:Widget Title}', '{{SLUG}}' );",
			"\t}",
			"",
			"\t/**",
			"\t * Get widget icon.",
			"\t *",
			"\t * @return string",
			"\t */",
			"\tpublic function get_icon() {",
			"\t\treturn 'eicon-${4:code}';",
			"\t}",
			"",
			"\t/**",
			"\t * Register Content tab controls.",
			"\t *",
			"\t * @return void",
			"\t */",
			"\tprotected function register_content_controls() {",
			"\t\t$this->start_controls_section(",
			"\t\t\t'content_section',",
			"\t\t\tarray(",
			"\t\t\t\t'label' => __( 'Content', '{{SLUG}}' ),",
			"\t\t\t\t'tab'   => Controls_Manager::TAB_CONTENT,",
			"\t\t\t)",
			"\t\t);",
			"",
			"\t\t$this->add_text_control( 'title', __( 'Title', '{{SLUG}}' ), __( 'Default Title', '{{SLUG}}' ) );",
			"\t\t$0",
			"",
			"\t\t$this->end_controls_section();",
			"\t}",
			"",
			"\t/**",
			"\t * Register Style tab controls.",
			"\t *",
			"\t * @return void",
			"\t */",
			"\tprotected function register_style_controls() {",
			"\t\t$this->start_controls_section(",
			"\t\t\t'style_section',",
			"\t\t\tarray(",
			"\t\t\t\t'label' => __( 'Style', '{{SLUG}}' ),",
			"\t\t\t\t'tab'   => Controls_Manager::TAB_STYLE,",
			"\t\t\t)",
			"\t\t);",
			"",
			"\t\t$this->add_color_control( 'title_color', __( 'Title Color', '{{SLUG}}' ), '', array( '{{WRAPPER}} .title' => 'color: {{VALUE}};' ) );",
			"",
			"\t\t$this->end_controls_section();",
			"\t}",
			"",
			"\t/**",
			"\t * Render widget output on frontend.",
			"\t *",
			"\t * @return void",
			"\t */",
			"\tprotected function render() {",
			"\t\t$settings = $this->get_settings_for_display();",
			"\t\t?>",
			"\t\t<div class=\"${3:widget_slug}-wrapper\">",
			"\t\t\t<?php if ( ! empty( $settings['title'] ) ) : ?>",
			"\t\t\t\t<h3 class=\"title\"><?php echo esc_html( $settings['title'] ); ?></h3>",
			"\t\t\t<?php endif; ?>",
			"\t\t</div>",
			"\t\t<?php",
			"\t}",
			"}"
		],
		"description": "Elementor Widget extending Abstract_Widget with content/style controls and render"
	}
}
