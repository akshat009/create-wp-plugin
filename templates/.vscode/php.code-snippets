	"WordPress OOP Singleton": {
		"prefix": "wpsingleton",
		"scope": "php",
		"body": [
			"<?php",
			"/**",
			" * ${1:Singleton class description}.",
			" *",
			" * @package {{NS}}",
			" */",
			"",
			"namespace {{NS}}${2:\\Subnamespace};",
			"",
			"if ( ! defined( 'ABSPATH' ) ) {",
			"\texit;",
			"}",
			"",
			"/**",
			" * Singleton class ${3:${TM_FILENAME_BASE}} for {{PLUGIN_NAME}}.",
			" */",
			"final class ${3:${TM_FILENAME_BASE}} {",
			"",
			"\t/**",
			"\t * Instance of this class.",
			"\t *",
			"\t * @var ${3:${TM_FILENAME_BASE}}|null",
			"\t */",
			"\tprivate static \\$instance = null;",
			"",
			"\t/**",
			"\t * Private constructor for singleton.",
			"\t */",
			"\tprivate function __construct() {",
			"\t\t$0",
			"\t}",
			"",
			"\t/**",
			"\t * Get instance.",
			"\t *",
			"\t * @return ${3:${TM_FILENAME_BASE}}",
			"\t */",
			"\tpublic static function get_instance() {",
			"\t\tif ( null === self::\\$instance ) {",
			"\t\t\tself::\\$instance = new self();",
			"\t\t}",
			"\t\treturn self::\\$instance;",
			"\t}",
			"}"
		],
		"description": "Full Singleton pattern (private constructor, static instance, get_instance)"
	},
