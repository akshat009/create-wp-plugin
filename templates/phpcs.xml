<?xml version="1.0"?>
<ruleset name="{{PLUGIN_NAME}} Coding Standards">
	<description>WPCS ruleset for {{PLUGIN_NAME}}.</description>

	<file>./{{SLUG}}.php</file>
	<file>./src</file>
	<file>./templates</file>
	<file>./tests</file>
	<file>./uninstall.php</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/assets/build/</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

{{PHPCS_RULESETS}}	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_supported_wp_version" value="{{REQUIRES_AT_LEAST}}"/>
	<config name="testVersion" value="{{MIN_PHP}}-"/>

	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>/tests/</exclude-pattern>
		<exclude name="Squiz.Commenting.FileComment.MissingSubpackageTag"/>
		<exclude name="Squiz.Commenting.FileComment.MissingAuthorTag"/>
		<exclude name="Squiz.Commenting.FileComment.MissingCopyrightTag"/>
		<exclude name="Squiz.Commenting.FileComment.SubpackageTagOrder"/>
		<exclude name="Squiz.Commenting.FileComment.AuthorTagOrder"/>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="{{PREFIX}}"/>
				<element value="{{PREFIX}}_"/>
				<element value="{{PREFIX_UPPER}}"/>
				<element value="{{PREFIX_UPPER}}_"/>
				<element value="{{NS_ROOT}}"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="{{SLUG}}"/>
			</property>
		</properties>
	</rule>
</ruleset>
